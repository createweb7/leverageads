NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Search Console: Settings -> Ownership verification -> HTML tag ->
# copy just the `content` attribute value (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend: dashboard.resend.com/api-keys
RESEND_API_KEY=
# Verified sending address in Resend (domain must be verified there)
RESEND_FROM_EMAIL=
# Where enquiry notifications should land
ENQUIRY_NOTIFICATION_EMAIL=

# Google reCAPTCHA v3: google.com/recaptcha/admin -> your site -> Settings
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
